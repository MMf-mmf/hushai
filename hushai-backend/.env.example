# Hushai backend configuration. Copy to `.env` for local dev (loaded via dotenvy).

# --- Required ---
# Postgres connection string. Local Homebrew Postgres:
DATABASE_URL=postgres://localhost/hushai
# Docker-compose Postgres would instead be: postgres://hushai:hushai@localhost:5433/hushai

# Blob volume root (created at boot if missing). Media lands under {BLOB_DIR}/blobs/ab/cd/<sha256>.
BLOB_DIR=./data

# Dev device token. The client sends `Authorization: Bearer <DEVICE_TOKEN>`.
DEVICE_TOKEN=dev-secret-token

# --- Optional (defaults shown) ---
# Address the server binds to.
BIND_ADDR=0.0.0.0:8080

# Max accepted request body in bytes (sized for ~2s segments). Oversized -> 413.
MAX_BODY_BYTES=33554432

# Global in-flight request cap. Excess -> 429.
CONCURRENCY_CAP=64

# Minimum free space (bytes) on the blob volume before shedding with 507.
DISK_WATERMARK_BYTES=1073741824

# Postgres pool sizing. Exhausting the pool surfaces as 507.
DB_MAX_CONNECTIONS=16
DB_ACQUIRE_TIMEOUT_SECS=2

# Overall per-request timeout (seconds).
REQUEST_TIMEOUT_SECS=30

# Tracing filter (RUST_LOG-style). Defaults to "info,hushai_backend=debug" if unset.
# RUST_LOG=info,hushai_backend=debug
