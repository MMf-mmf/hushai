<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only. The verified backend serves cleartext HTTP on :8080 over the LAN
     (and 10.0.2.2 for the emulator), so debug builds must permit cleartext. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
