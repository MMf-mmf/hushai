<?xml version="1.0" encoding="utf-8"?>
<!-- Release overlay: attach the HTTPS-only network-security config (which trusts the
     bundled LAN CA). Mirrors the debug overlay's shape, but cleartext-free. This
     attribute lands only in release builds; debug keeps its own cleartext config. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
