<?xml version="1.0" encoding="utf-8"?>
<!-- Only force-lock: lets battery-saver call lockNow() to turn the screen off
     while capture keeps running. No wipe/password/other admin powers. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
