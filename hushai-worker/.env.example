# hushai-worker configuration. Shared DB vars (DATABASE_URL, BLOB_DIR, DEVICE_TOKEN)
# are reused from hushai-backend's config; set them in the workspace-root .env.

# Local whisper.cpp GGML model (ASR). Download e.g.:
#   curl -L -o models/ggml-base.en.bin \
#     https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin
WHISPER_MODEL_PATH=./models/ggml-base.en.bin

# Local Ollama server (embeddings). Pull the model once: `ollama pull mxbai-embed-large`.
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=mxbai-embed-large          # MUST be 1024-dim to match the schema

WORKER_CONCURRENCY=2                    # concurrent per-segment pipelines
POLL_INTERVAL_SECS=5                    # idle poll cadence (keep-up mode)
MAX_ATTEMPTS=5                          # retries before a segment stays in 'error'
LEASE_TIMEOUT_SECS=300                  # a 'processing' claim older than this is re-leased
FFMPEG_BIN=ffmpeg                       # ffmpeg binary used to decode segment audio
