# hushai-worker configuration. Shared DB vars (DATABASE_URL, BLOB_DIR, DEVICE_TOKEN)
# are reused from hushai-backend's config; set them in the workspace-root .env.

# Local whisper.cpp GGML model (ASR). Download e.g.:
#   curl -L -o models/ggml-base.en.bin \
#     https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin
WHISPER_MODEL_PATH=./models/ggml-base.en.bin

# Whisper decode-quality / anti-hallucination knobs (defaults = whisper.cpp defaults = NO behavior
# change; validated against hushai-eval). Calibrate per-deployment to fight hallucinated tails on
# noisy/looped audio, then re-run hushai-eval to confirm WER doesn't regress (flipping suppress_nst
# true regressed fdr_infamy WER 0.562→0.625, so it ships OFF):
WHISPER_NO_SPEECH_THOLD=0.6            # ≥ this no-speech prob ⇒ segment dropped
WHISPER_LOGPROB_THOLD=-1.0            # less-negative ⇒ more low-confidence segments dropped
WHISPER_ENTROPY_THOLD=2.4            # higher ⇒ degenerate/repetitive decodes fall back/dropped
WHISPER_SUPPRESS_NST=false           # suppress non-speech tokens ([music]/(applause)); shifts decode

# Local Ollama server (embeddings). Pull the model once: `ollama pull mxbai-embed-large`.
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=mxbai-embed-large          # MUST be 1024-dim to match the schema

# ---- Parallelism (audio + vision fan-out, CPU thread budget) ------------------------------------
# The worker drains a SKIP-LOCKED queue with WORKER_CONCURRENCY audio loops + VISION_CONCURRENCY
# vision loops in parallel (and is multi-process-safe — point a 2nd worker host at the same DB to
# scale out for free). To find the saturation knee on your box, sweep these with the loadtest:
#   ./local_dev/run_loadtest.sh conc1 conc2 conc4 conc6          # audio-lane concurrency
#   ./local_dev/run_loadtest.sh visconc1 visconc2 visconc4       # vision-lane concurrency
WORKER_CONCURRENCY=2                    # concurrent AUDIO pipelines (whisper/embed/speaker)
VISION_CONCURRENCY=2                    # concurrent VISION pipelines (face/object/plate); was effectively 1
# CPU thread budget. Each whisper/ORT call otherwise grabs ALL cores, so N parallel loops oversubscribe
# the box and net far less than N×. Leave these at 0 to auto-derive cores/(WORKER+VISION concurrency);
# set explicitly to pin (e.g. when most loops sit idle on I/O). CoreML-offloaded vision nodes are
# unaffected. The chosen budget is logged once at startup ("concurrency budget").
ASR_THREADS=0                          # 0 = auto (whisper n_threads per transcription)
ORT_INTRA_THREADS=0                    # 0 = auto (ORT intra-op threads per vision session)
# NOTE: when WORKER_CONCURRENCY > 2, raise the shared DB pool and Ollama parallelism too, or they
# become the next bottleneck:
#   * DB_MAX_CONNECTIONS (workspace-root .env, default 16) >= WORKER_CONCURRENCY + VISION_CONCURRENCY
#     + ~3 (heartbeat/listener/delivery) + backend + rag headroom. Bump to ~32 near core-many loops
#     (and match Postgres `max_connections`).
#   * On the Ollama server, set OLLAMA_NUM_PARALLEL >= max(WORKER_CONCURRENCY, 4) so the genuinely-
#     parallel embed + sentiment requests don't serialize server-side. Consider splitting
#     EMBED_OLLAMA_BASE_URL and LLM_OLLAMA_BASE_URL onto separate Ollama instances under load (below).
POLL_INTERVAL_SECS=5                    # idle poll cadence (keep-up mode)
MAX_ATTEMPTS=5                          # retries before a segment stays in 'error'
LEASE_TIMEOUT_SECS=300                  # a 'processing' claim older than this is re-leased
FFMPEG_BIN=ffmpeg                       # ffmpeg binary used to decode segment audio

# Device load governor — pace processing so the box is NEVER overloaded. A monitor task watches the
# backlog-lag TREND (is the oldest pending item getting older?) + optionally the OS load average, and
# publishes Normal/Elevated/Saturated. Under load the EXPENSIVE vision lane pauses first and lanes
# take an inter-segment cooldown; nothing is dropped — the durable queue drains oldest-first when
# load clears (organic quiet-time drain). Disabled ⇒ legacy always-claim behavior.
LOAD_GOVERNOR_ENABLED=true
LOAD_SAMPLE_SECS=5                      # monitor sample / re-decide cadence
LOAD_SLOPE_ELEVATED=0.05               # backlog-lag slope (s/s) entering Elevated (matches loadtest EPS_SLOPE)
LOAD_SLOPE_SATURATED=0.10              # ... entering Saturated
LOAD_GOVERNOR_USE_CPU=true             # also use the OS 1-min load average (normalized by cores)
LOAD_CPU_ELEVATED=0.80                 # normalized load avg entering Elevated
LOAD_CPU_SATURATED=0.95                # ... entering Saturated
LOAD_RECOVER_SAMPLES=3                 # consecutive calmer samples before stepping the level DOWN (anti-flap)
LOAD_PAUSE_VISION_FIRST=true           # pause vision (expensive lane) before audio at Saturated
BACKLOG_COOLDOWN_MS=0                  # inter-segment cooldown at Elevated (ms)
BACKLOG_SATURATED_COOLDOWN_MS=250      # inter-segment cooldown at Saturated (ms) for the still-running lane

# Per-segment lexical sentiment (positive|neutral|negative) via the local Ollama chat
# model. Reuses the RAG answer model; pull it once: `ollama pull llama3.2:3b`.
LLM_OLLAMA_BASE_URL=http://localhost:11434   # falls back to OLLAMA_BASE_URL if unset
SENTIMENT_MODEL=llama3.2:3b
SENTIMENT_ENABLED=true                  # set false to leave sentiment NULL (skip the LLM)
SENTIMENT_TIMEOUT_MS=3000               # on timeout the worker writes NULL (never stalls)

# Server-side speaker identity (192-dim) via sherpa-onnx + NVIDIA TitaNet-large. Download:
#   curl -L -o models/nemo_en_titanet_large.onnx \
#     https://github.com/k2-fsa/sherpa-onnx/releases/download/speaker-recongition-models/nemo_en_titanet_large.onnx
#   (sha256 d51abcf31717ef28162f26acb9d44dd4127c3d44c9b8624f699f3425daca8e77)
SPEAKER_MODEL_PATH=./models/nemo_en_titanet_large.onnx
SPEAKER_MATCH_THRESHOLD=0.5             # cosine DISTANCE; <= this MATCHES + folds into centroid
SPEAKER_MIN_SPEECH_SECS=0.3            # reject gate: skip speaker work below this much (post-VAD) speech. Calibrated for short ~2s clips (was 0.8)
SPEAKER_SPLIT_THRESHOLD=0.6            # cleaned halves farther apart than this => multi-speaker, refuse

# Real VAD (sherpa Silero) — strips static/silence so only speech reaches the embedder.
# This is the core fix for static fragmenting one person into many "unknown" voices.
# Fetch the model once: `local_dev/fetch_vad_model.sh` (or)
#   curl -fSL -o models/silero_vad.onnx \
#     https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/silero_vad.onnx
#   (sha256 9e2449e1087496d8d4caba907f23e0bd3f78d91fa552479bb9c23ac09cbb1fd6)
VAD_MODEL_PATH=./models/silero_vad.onnx
VAD_THRESHOLD=0.5                       # Silero speech-probability cutoff (higher = stricter)
VAD_MIN_SILENCE_SECS=0.3                # silence that ends a speech segment (bridges word gaps)
VAD_MIN_SPEECH_SECS=0.25               # min speech for a Silero segment (drops isolated blips)

# Skip-silent gate — don't pay for whisper on a segment with no speech. Two stages, cheapest
# first: a free RMS floor short-circuits dead air, else the (already-loaded) Silero VAD makes the
# definitive call. A skipped segment writes nothing and is marked terminal `skipped`
# (skip_reason='silent_gate', measured RMS/speech-secs persisted as calibration telemetry).
# Fails OPEN (a VAD error falls through to normal ASR). Set ENABLED=false for legacy behavior.
AUDIO_SILENCE_SKIP_ENABLED=true
AUDIO_SILENCE_RMS_FLOOR=0.005           # RMS at/under this is dead air (skip without the VAD); ~-46 dBFS
AUDIO_SILENCE_MIN_SPEECH_SECS=0.2       # post-VAD speech under this ⇒ skip; keep BELOW SPEAKER_MIN_SPEECH_SECS

# Mint quality gates — a NEW identity may ONLY be born from clean, loud, long-enough audio.
# Marginal/noisy speech can still ATTACH to a known voice but never spawns a duplicate.
SPEAKER_MINT_MIN_SPEECH_SECS=1.2        # mint needs more cleaned speech than attach
SPEAKER_MINT_MIN_SNR_DB=3.0             # mint needs speech above the noise floor (lowered from 10.0 for real phone/room audio; voiced-frac gate still guards minting)
SPEAKER_MINT_MIN_VOICED_FRAC=0.5        # mint needs at least half the segment to be real speech

# Multi-vector k-NN matcher + mint-guard hysteresis (matches raw embeddings, not 1 centroid).
SPEAKER_MINT_DISTANCE_FLOOR=0.72        # mint ONLY when nearest is farther than this; gray zone attaches
SPEAKER_KNN_K=15                        # nearest raw neighbors pulled per match
SPEAKER_KNN_NEIGHBOR_CEILING=0.55       # neighbors beyond this cosine distance don't vote
SPEAKER_KNN_MIN_NEIGHBORS=3             # below this, fall back to the centroid (cold-start)
SPEAKER_KNN_EF_SEARCH=200               # HNSW ef_search for the filtered vote-pool walk
SPEAKER_KNN_STATEMENT_TIMEOUT_MS=5000   # tx-scoped guard; generous so it never aborts the write
SPEAKER_CENTROID_WINDOW=50              # recompute centroid from N recent CLEAN segments (self-healing)

# Going-forward auto-merge ("auto-merge near-certain duplicates; suggest the rest").
SPEAKER_AUTOHEAL_ENABLED=true           # worker 0 auto-merges after a backlog drain
SPEAKER_AUTOHEAL_DISTANCE=0.15          # only auto-merge near-certain (very tight) duplicates
SPEAKER_AUTOHEAL_RECENT_SECS=3600       # only among recently-active speakers (not the backlog)
SPEAKER_AUTOHEAL_MIN_LINKS=2            # >= this many agreeing cross-pairs to link two speakers
SPEAKER_AUTOHEAL_KNN_K=5                # cross-speaker neighbor probe size
SPEAKER_AUTOHEAL_INTERVAL_SECS=300      # min seconds between auto-merge passes

# Startup self-heal: re-queue `done` AUDIO/MUXED segments that have no voiceprint yet
# (transcribed while the speaker stage was unavailable) so the pipeline re-runs and
# assigns/mints their speaker. Convergent (a no-op once every segment has a speaker_segments
# row — incl. a quality='reject' tombstone for genuinely no-voice segments). Set to false/0
# to skip the one-time re-ASR cost of any currently-stranded backlog.
SPEAKER_BACKFILL_ON_START=true

# One-shot reprocess: on startup, DELETE quality='reject' tombstones and re-queue those
# segments so they're re-evaluated under the CURRENT gates. Use for ONE run after changing the
# SPEAKER_* thresholds / window settings (a tombstone is otherwise sticky), then set back to false.
SPEAKER_REPROCESS_REJECTS_ON_START=false

# Rolling-window speaker embedding. Clients upload short (~2s) clips, so a single segment
# often has < SPEAKER_MIN_SPEECH_SECS of post-VAD speech and gets rejected. With windowing on,
# the speaker voiceprint is embedded over a segment PLUS its contiguous same-stream
# predecessors (stopping at a capture gap / sequence break), accumulating enough speech to
# attribute (or mint) the voice honestly. Off => legacy per-segment embedding.
SPEAKER_WINDOW_ENABLED=true
SPEAKER_WINDOW_TARGET_SECS=6.0          # accumulate look-back audio until raw secs >= this (≈3 short clips)
SPEAKER_WINDOW_MAX_SEGMENTS=6           # hard cap on segments per window (decode bound)

# ============================================================================================
# VISION (Phase A: person/face identity + open-vocabulary objects). Processes VIDEO/MUXED
# segments (media_type IN (2,3)) on a SEPARATE claim/status queue from ASR. If any model or the
# ORT dylib is missing, vision self-disables with a warning and the audio path keeps running.
# ============================================================================================
VISION_ENABLED=true

# ONNX Runtime for the vision models. The vision worker runs ONNX via the `ort` crate with the
# `load-dynamic` feature, which dlopen()s libonnxruntime at runtime instead of link-time — this
# is REQUIRED to coexist with sherpa-rs's statically-bundled onnxruntime 1.17.1 (different
# version). ort-sys rc.9 targets ONNX Runtime 1.20.0, so this MUST be a 1.20.x build.
# Fetch once: `local_dev/fetch_onnxruntime.sh`.
ORT_DYLIB_PATH=./models/onnxruntime/onnxruntime-osx-arm64-1.20.0/lib/libonnxruntime.1.20.0.dylib
VISION_COREML=true                      # register the CoreML EP ahead of CPU (Apple Silicon); CPU fallback

# Vision model files (ONNX), NOT committed (operator-fetched; models/ is gitignored). Provision:
#   - Face detect + 5-pt landmarks: YuNet (OpenCV Zoo, Apache-2.0)
#       https://github.com/opencv/opencv_zoo  -> models/face_detection_yunet_*.onnx
#   - Face embedding (512-d): ArcFace w600k_r50 (InsightFace buffalo_l). NOTE: the WEIGHTS are
#       NON-COMMERCIAL RESEARCH-only (the *code* path here stays MIT; do not commit the weights).
#       https://huggingface.co/garavv/arcface-onnx  -> models/w600k_r50.onnx
#   - Object detection (Apache-2.0): RF-DETR-Nano, exported to ONNX from the `rfdetr` Python pkg:
#       `python -c "from rfdetr import RFDETRNano; RFDETRNano().export(format='onnx')"`
#       -> models/rf-detr-nano.onnx
#   - Open-vocab embedding: OpenCLIP ViT-B/32 IMAGE tower exported to ONNX (512-d).
#       -> models/clip_vit_b32_image.onnx   (the RAG service uses the matching TEXT tower)
FACE_DETECT_MODEL_PATH=./models/face_detection_yunet_2023mar.onnx
FACE_EMBED_MODEL_PATH=./models/w600k_r50.onnx
OBJECT_DET_MODEL_PATH=./models/rf-detr-nano.onnx
OBJECT_CLASSES_PATH=./models/rf-detr-classes.json   # COCO-91 column→label map (authoritative; falls back to built-in)
OBJECT_NMS_IOU=0.5                       # class-aware NMS IoU for RF-DETR duplicate-box suppression
CLIP_IMAGE_MODEL_PATH=./models/clip_vit_b32_image.onnx

FRAMES_PER_SEGMENT=3                     # frames sampled per ~2s segment for detect/embed (recall vs cost; motion-gate skips static)

# Skip-static gate — don't re-run vision on an unchanged scene. Compares this segment's gate frame
# to the same camera's previously-analyzed frame (cheap mean-subtracted MSE over a 32x32 grayscale
# tile, robust to night IR/auto-exposure drift). A near-identical scene skips ALL face/object/plate
# inference (writes nothing, marked terminal `skipped` with skip_reason='static_gate'); presence
# continuity comes from event sessionization.
# Set ENABLED=false for legacy behavior AND for any full reprocess/calibration run (the in-memory
# per-camera baseline isn't meaningful when replaying old segments out of order).
VISION_MOTION_SKIP_ENABLED=true
VISION_MOTION_THRESHOLD=8.0              # mean-subtracted MSE at/under which a frame is "static" (UNCALIBRATED)
VISION_MOTION_FP_SIDE=32                 # fingerprint tile side (NxN grayscale); ~1 KB/camera
WORKER_GATE_ONE_FRAME_PROBE=true         # decode 1 frame for the gate, full set only after motion confirms (~1/3 static decode cost)

# Face match-or-mint (cosine DISTANCE; mirrors the SPEAKER_* matcher). UNCALIBRATED starting
# guesses — calibrate FACE_MATCH_THRESHOLD on a real two-person fixture (see the plan's How to Test:
# sweep distance, watch distinct-person-id count vs the known number of people).
FACE_MATCH_THRESHOLD=0.5                 # at/under => confident same person (folds the centroid)
FACE_MINT_DISTANCE_FLOOR=0.72            # beyond => may mint a NEW person (clean faces only)
FACE_KNN_K=15
FACE_KNN_NEIGHBOR_CEILING=0.55
FACE_KNN_MIN_NEIGHBORS=3
FACE_KNN_EF_SEARCH=200
FACE_KNN_STATEMENT_TIMEOUT_MS=5000
FACE_CENTROID_WINDOW=50

# Quality gates before embedding a face crop (a bad crop poisons a centroid — skip it).
FACE_MIN_DET_SCORE=0.6                   # min YuNet detection confidence
FACE_MIN_PX=40                           # min face bbox side in px (a 20px face embeds to noise)
FACE_MIN_SHARPNESS=30.0                  # min variance-of-Laplacian (reject motion-blurred crops)

OBJECT_MIN_DET_SCORE=0.4                 # min RF-DETR detection confidence to keep an object

# ---- IMAGE CLEANUP / FACE RESTORATION (zoom + clean up a crop before we recognize it) ----------
# The cascade RESTORES low-quality faces the old gate dropped ("recover-then-embed"): SCRFD detect ->
# crop-with-margin -> super-resolve (if tiny) -> blind-face-restore -> align -> ArcFace (+flip-TTA).
# Provision: local_dev/fetch_scrfd.sh, export_gfpgan.py, fetch_realesrgan.sh. All non-fatal: a missing
# model self-disables just that step. Validate: cargo test -p hushai-worker --test vision_pipeline \
#   inspect_enhance_model_io_shapes / restored_low_quality_recovers_identity -- --nocapture
FACE_DETECTOR_KIND=scrfd                  # scrfd (best small/distant recall; default) | yunet (fallback)
FACE_SCRFD_MODEL_PATH=./models/scrfd_10g_bnkps.onnx
FACE_EMBED_FLIP_TTA=true                  # average a crop's embedding with its mirror (accuracy win)
FACE_CROP_MARGIN_FRAC=0.35                # context added around the bbox before the restorer sees it
FACE_RESTORE_MODEL_PATH=./models/gfpgan_v1.4.onnx
FACE_RESTORE_KIND=gfpgan                  # gfpgan (identity-faithful; default) | codeformer
FACE_RESTORE_CODEFORMER_W=0.6             # CodeFormer fidelity weight (ignored by GFPGAN)
FACE_RESTORE_MAX_SHARPNESS=45.0           # restore only crops blurrier than this (clean faces skip it)
FACE_RESTORE_MIN_PX=80                    # ...or smaller (shorter side px) than this
FACE_HARD_MIN_PX=16                       # below this, even restoration can't help -> hard drop
FACE_HARD_MIN_DET_SCORE=0.3
FACE_UPSCALE_MODEL_PATH=./models/realesrgan_x4plus.onnx   # optional super-res (shared with plates)
FACE_UPSCALE_MIN_PX=48                    # super-resolve a crop smaller than this before restoring
FACE_MINT_MAX_YAW_DEG=35.0               # a face beyond this yaw/pitch may match but not MINT a new id
FACE_MINT_MAX_PITCH_DEG=30.0
FACE_RESTORED_MAY_MINT=true               # dev-stage: restored faces may mint/fold (set false on a
                                          # populated catalog until calibration proves space-compat)
FACE_PERSIST_CROP=true                    # write the cleaned best-shot crop so the UI shows it
FACE_BEST_SHOT_ENABLED=true
BLOB_DIR=./blobs                          # shared with the backend; face/plate crops go under it

# ---- LICENSE-PLATE RECOGNITION (ALPR) — runs after vehicle detection -----------------------------
# For each car/truck/bus/motorcycle (RF-DETR) ROI: zoom in -> detect plate (+corners) -> rectify
# (deskew) -> super-resolve + CLAHE + sharpen -> OCR -> vote across frames -> match-or-mint by string.
# Needs RF-DETR (OBJECT_DET_MODEL_PATH) + a plate detector + a plate OCR model + its charset; any
# missing piece self-disables the lane. Provision: local_dev/fetch_plate_detector.sh, export_plate_ocr.py.
# Validate: cargo test -p hushai-worker --test vision_pipeline inspect_plate_model_io_shapes -- --nocapture
# ALPR (provision: local_dev/fetch_plate_detector.sh + export_plate_ocr.py). Default detector =
# open-image-models yolo-v9-t-640 (MIT) which is END2END; default OCR = fast-plate-ocr CCT (uint8 in).
PLATE_ENABLED=true
PLATE_DETECT_MODEL_PATH=./models/lp_detector.onnx
PLATE_DETECT_END2END=true                 # true = [N,7] xyxy NMS-baked (open-image-models); false = raw YOLOv8/11 [C,N]
PLATE_OCR_MODEL_PATH=./models/lp_ocr_cct.onnx
PLATE_OCR_CTC=false                       # false = fixed-length CCT (fast-plate-ocr); true = CTC/CRNN duplicate-collapse
PLATE_OCR_CHARSET_PATH=./models/lp_ocr_charset.json   # ordered class->char map (array of 1-char strings)
PLATE_DETECT_INPUT_SIZE=640
PLATE_MIN_DET_SCORE=0.35
PLATE_MIN_PX=16                           # min plate bbox side (orig-frame px)
PLATE_MIN_OCR_CONF=0.55                   # min mean per-char OCR confidence to keep a read
PLATE_MINT_MIN_OCR_CONF=0.80             # higher bar to MINT a new catalog plate
PLATE_MIN_LEN=4                           # reject reads shorter than this many chars
PLATE_MAX_EDIT_DISTANCE=1                 # fuzzy (OCR-noise) match budget to an existing plate
PLATE_FUZZY_MIN_SIMILARITY=0.7           # trigram similarity floor for a fuzzy candidate
PLATE_VEHICLE_ROI_MARGIN=0.10            # expand the vehicle bbox before cropping the ROI
PLATE_SR_MIN_SIDE_PX=64.0                 # super-resolve a rectified plate smaller than this
PLATE_DETECT_WHOLE_FRAME=false           # true = ALSO scan the whole frame (not just vehicle ROIs) — catches plates outside an imperfect car box
PLATE_REQUIRED=false                      # true => a missing plate model disables the WHOLE vision subsystem
# PERSON_SIGHTING_GAP_SECONDS / PLATE_SIGHTING_GAP_SECONDS (default 60) sessionize detections into
# "sightings" for the backend /v1/persons and /v1/plates lists.
