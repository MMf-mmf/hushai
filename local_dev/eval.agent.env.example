# TEMPLATE — `cp local_dev/eval.agent.env.example local_dev/eval.agent.env` (the live file is
# gitignored like eval.env). Values are dev defaults for the hushai_test eval stack.
#
# eval.agent.env — STAGING-ONLY determinism layer for the Gotham `agent` eval modality (G3 / Phase F).
#
# WHY a SEPARATE file (not eval.env): the `agent` modality's GOTHAM_* knobs are hand-listed in
# hushai-eval/src/manifest.rs KNOBS, so any GOTHAM_* that is SET in the eval process env folds into
# the config-hash. Keeping them OUT of the shared local_dev/eval.env means a plain
# `--fixtures all` run (graph + perception, the FROZEN d4acc862 lineage) has NO GOTHAM_* set and
# still hashes to d4acc862 — untouched. Sourcing THIS file on top of eval.env for a staging agent
# run mints the agent modality's OWN baseline lineage (baselines/<newhash>/) without ever disturbing
# the gating suite.
#
# USAGE — source BOTH, in this order, for BOTH the rag service AND the hushai-eval process:
#   set -a; source local_dev/eval.env; source local_dev/eval.agent.env; set +a
# The rag service needs it to ENABLE + pin the Detective runtime deterministically; the eval process
# needs the IDENTICAL values so its computed config-hash matches the frozen agent baselines.
#
# Bring the stack up with it (the run_stack `set -a; source eval.env` already runs, so just export
# these first):  `set -a; source local_dev/eval.agent.env; set +a; ./local_dev/run_stack.sh --test-db --no-build`
# Run the agent staging suite with it:
#   set -a; source local_dev/eval.env; source local_dev/eval.agent.env; set +a
#   cargo run -p hushai-eval -- run --tier full --fixtures staging --case agent_single_tool

GOTHAM_ENABLED=true
GOTHAM_RUNTIME=rig
GOTHAM_LLM_MODEL=qwen2.5:7b
# Belt-and-suspenders determinism: temperature 0 + a fixed Ollama seed. Nondeterministic by default
# (GOTHAM_SEED unset -> Ollama picks a random seed), which is why the agent modality is staging-only
# and calibrated with two agreeing runs before any baseline is frozen.
GOTHAM_TEMPERATURE=0
GOTHAM_SEED=42
GOTHAM_NUM_CTX=16384
# The Detective's graph tools call the backend /v1/graph/* API (loopback), which is token-gated.
# Without this the calls 401 and the graph tools silently degrade. NOT hashed (it is a secret, kept
# out of manifest KNOBS on purpose) — setting it does not shift config_hash. In the eval stack this
# is the same DEVICE_TOKEN run_stack mints for hushai_test.
GOTHAM_BACKEND_TOKEN=dev-secret-token
# Hard loop bounds (also the F11/F12 cap assertions' reference).
GOTHAM_MAX_TURNS=6
GOTHAM_MAX_TOOL_CALLS=8
GOTHAM_TOOL_TIMEOUT_MS=20000
GOTHAM_WALL_CLOCK_SECS=120
