# Rust build artifacts (~3.3 GB)
target/
**/target/

# Secrets / environment
.env
**/.env
*.env
!.env.example
!**/.env.example

# Local data / databases
hushai-backend/data/
# Root-level blob/cache dirs created when a service is run from the repo root
# (real blobs live in hushai-backend/data/; this is a stray runtime scratch dir).
/data/

# Per-service logs + pid files written by local_dev/run_stack.sh
local_dev/logs/

# Prior LocalHostName saved by local_dev/setup_hostname.sh (host-specific; for --remove).
local_dev/.hostname_backup

# Local TLS material (CA + LAN server cert + keys) from local_dev/gen_certs.sh.
# Never commit private keys; regenerate per host.
local_dev/certs/
# The LAN CA copied into the Android release build to trust the self-signed cert.
hushai-android/app/src/release/res/raw/hushai_lan_ca.pem

# Captured test media (regenerable; can be large)
local_dev/captures/

# Regenerable HLS output written by local_dev/feed_segments.py (segments + sidecars).
local_dev/.feed_work/

# Synthesized object-lane test fixture (make_object_clip.sh) — regenerable, operator-provisioned.
object_clip.mp4

# Large, downloadable ML model binaries — kept out of git (fetch, don't commit).
# whisper.cpp model for hushai-worker (see hushai-backend/README); ~141 MB.
models/
# Vosk acoustic + speaker models bundled into the Android app's assets; ~82 MB.
# Re-fetch with local_dev/fetch_vosk_models.sh
hushai-android/app/src/main/assets/vosk/

# Python
__pycache__/
*.pyc
# Vision export/OCR virtualenv (~448 MB; recreate with local_dev/provision_vision.sh).
local_dev/.venv*/

# OS cruft
.DS_Store

# Self-managed git repo (has its own history)
/Agent Ahithophel/
