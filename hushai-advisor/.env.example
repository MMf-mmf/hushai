# hushai-advisor configuration. Shared DB vars (DATABASE_URL, BLOB_DIR, DEVICE_TOKEN)
# are reused from hushai-backend's config; set them in the workspace-root .env.

# Local Ollama server (embeddings + all advisor LLM calls).
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=mxbai-embed-large          # MUST match the worker's embedding model (1024-dim space)
ADVISOR_LLM_MODEL=qwen2.5:7b           # drafting/refining model
# ADVISOR_JUDGE_MODEL=qwen2.5:14b      # optional larger model for the JUDGE steps only
#                                        (sufficiency gate + answer critique) — a 7B judge
#                                        tends to rubber-stamp its own drafts

ADVISOR_BIND_ADDR=0.0.0.0:8095
# Bearer token. STRONGLY recommended (advisor binds 0.0.0.0 and holds the user's most
# intimate data): unset = refuses to start on a non-loopback bind unless
# ADVISOR_ALLOW_INSECURE=true. run_stack.sh mints one automatically.
# ADVISOR_TOKEN=dev-secret-token

# Ollama context window for the advisor's calls. The advisor feeds 2-6 FULL book
# chapters into one prompt; Ollama's 4096 default would SILENTLY truncate it.
# KV-cache cost at 16384 on a 7B q4 is roughly 2-3 GB extra.
ADVISOR_NUM_CTX=16384

# Determinism (the eval harness gates on these): greedy decode + fixed seed.
ADVISOR_LLM_TEMPERATURE=0.0
# ADVISOR_LLM_SEED=42

# Pipeline caps — every loop is hard-bounded so a flaky local model can never wedge
# a consultation.
ADVISOR_MAX_FOLLOWUP_ROUNDS=2          # Yenta rounds before the gate force-proceeds
ADVISOR_MAX_QUESTIONS_PER_ROUND=3
ADVISOR_MAX_REFINE_ITERS=3             # route->draft->critique iterations per answer
ADVISOR_MAX_CHAPTERS_PER_ROUTE=4
ADVISOR_MAX_TOTAL_CHAPTERS=6

# Prompt budgets (chars — repo idiom, not tokens).
ADVISOR_CHAPTER_MAX_CHARS=12000        # above this a chapter is represented by its nearest chunks
ADVISOR_CONTEXT_MAX_TOTAL_CHARS=36000
ADVISOR_HISTORY_TURNS=8
ADVISOR_MAX_MESSAGE_CHARS=4000

# Traffic-Controller semantic widening (anti-tunnel-vision): top-k chunk hits whose
# chapters are offered to the router as extra candidates.
ADVISOR_ROUTE_SEMANTIC_TOP_K=8

# Past-consultation memory (advisor_memories): retrieval into new consultations.
ADVISOR_MEMORY_ENABLED=true
ADVISOR_MEMORY_TOP_K=3
ADVISOR_MEMORY_DISTANCE_THRESHOLD=0.6

# Native TLS (rustls). ADVISOR_-prefixed, falling back to the bare TLS_CERT_PATH/TLS_KEY_PATH.
# ADVISOR_TLS_CERT_PATH=/abs/path/to/local_dev/certs/server.fullchain.crt
# ADVISOR_TLS_KEY_PATH=/abs/path/to/local_dev/certs/server.pkcs8.key

# One-time corpus ingest (re-run safe; only changed chapters re-embed). NB: keep the
# comma in the title — the running-head strip patterns derive from its comma/colon
# parts ("Yes!" appears as a page-top head line inside chapter text).
#   cargo run -p hushai-advisor --bin ingest-book -- \
#     --dir "Agent Ahithophel/books/chapters_text" \
#     --slug yes-50-ways \
#     --title "Yes!, 50 Scientifically Proven Ways to Be Persuasive"
