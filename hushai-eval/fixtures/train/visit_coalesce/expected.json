        "filters": {
          "device_id": "eval-visits"
        }
      },
      {
        "ask": "How many people have we seen?",
        "expect_number": 1,
        "must_not_contain": [
          "don't have"
        ]
      },
      {
        "ask": "Tell me about Judith.",
        "expect_routed_agent": "people",
        "must_contain": [
          "judith"
        ],
        "must_not_contain": [
          "don't have"
        ]
      }
    ]
  }
}