# hushai-rag configuration. Shared DB vars (DATABASE_URL, BLOB_DIR, DEVICE_TOKEN)
# are reused from hushai-backend's config; set them in the workspace-root .env.

# Local Ollama server (embeddings + chat LLM).
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=mxbai-embed-large          # MUST match the worker's embedding model
RAG_LLM_MODEL=llama3.2:3b              # `ollama pull llama3.2:3b`

RAG_BIND_ADDR=0.0.0.0:8090
RAG_TOP_K_DEFAULT=8                     # default nearest passages retrieved
RAG_DISTANCE_THRESHOLD=0.6             # cosine-distance cutoff for context/sources
# RAG_TOKEN=dev-secret-token           # when set, require this bearer token; unset = no auth
