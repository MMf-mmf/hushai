# hushai-rag configuration. Shared DB vars (DATABASE_URL, BLOB_DIR, DEVICE_TOKEN)
# are reused from hushai-backend's config; set them in the workspace-root .env.

# Local Ollama server (embeddings + chat LLM).
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=mxbai-embed-large          # MUST match the worker's embedding model
RAG_LLM_MODEL=llama3.2:3b              # `ollama pull llama3.2:3b`

RAG_BIND_ADDR=0.0.0.0:8090
RAG_TOP_K_DEFAULT=8                     # default nearest passages retrieved
RAG_DISTANCE_THRESHOLD=0.6             # cosine-distance cutoff for context/sources
# RAG_TOKEN=dev-secret-token           # when set, require this bearer token; unset = no auth

# --- Reflection agent (introspective "how have I been?" analytics) -------------------
# The reflection agent analyzes ALL transcripts for ONE target speaker. For the voice
# "how have I been" case it needs to know which speaker is the owner. Name your own voice
# in the Android Voices screen, then point one of these at it (id wins over name). With
# neither set, the reflection agent declines unless a speaker filter is supplied.
# OWNER_SPEAKER_ID=<speaker-uuid>
# OWNER_SPEAKER_NAME=Me
ANALYSIS_WINDOW_DAYS_DEFAULT=90        # default look-back window for the digest
CONVERSATION_GAP_SECS=300             # silence > this starts a new derived "conversation"
ANALYSIS_TZ_OFFSET_SECS=0             # offset before hour-of-day/week bucketing AND the assistant's
                                      # relative-time phrasing (today/yesterday + clock). Set to your
                                      # local UTC offset in seconds (e.g. EDT=-14400); 0 = UTC.
# REFLECTION_LLM_MODEL=llama3.1:8b     # optional larger model for digest→coaching synthesis
#                                       (must be pulled on the LLM Ollama instance)
